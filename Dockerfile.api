# Dockerfile.api — Cloud Run / FastAPI Control Plane + Deterministic Engines
FROM python:3.13.2-slim-bookworm

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    CAUSALBOUND_DATA_DIR=/app/data \
    PORT=8080

RUN groupadd --gid 1000 appuser && \
    useradd --uid 1000 --gid 1000 --create-home --shell /bin/bash appuser

WORKDIR /app
COPY pyproject.toml README.md ./
COPY src/ ./src/
COPY scripts/ ./scripts/
COPY benchmarks/ ./benchmarks/

RUN pip install --no-cache-dir ".[control-plane]" && \
    python scripts/build_assets.py && \
    python benchmarks/run_v1_vs_v2.py && \
    chown -R appuser:appuser /app

USER appuser
EXPOSE 8080

CMD ["sh", "-c", "uvicorn causalbound.api:app --host 0.0.0.0 --port ${PORT}"]
